# Copy to .env (git-ignored). Deployed secrets live in SSM Parameter Store.

# AWS
AWS_REGION=ap-south-1
# Region for Bedrock calls if Nova isn't available in ap-south-1
BEDROCK_REGION=ap-south-1

# API (local dev)
STAGE=dev
PORT=8080

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public contact address shown on About, Privacy and Terms (hidden when empty)
NEXT_PUBLIC_CONTACT_EMAIL=
# Canonical site URL for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
